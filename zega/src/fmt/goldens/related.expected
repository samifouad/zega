schema {
  type Country {
    name: String
    iso: String
    airports: BASE <- Airport[]
  }

  type Airport {
    code: String
    country: BASE -> Country
    route: ROUTE -> Airport[]
    inbound: ROUTE <- Airport[]
  }
}

query {
  Airport(has country(iso = "CA")) {
    code
    route -> Airport { code }
  }
}

query {
  Airport(has country(iso = "CA") && has route in country(iso = "JP")) { code }
}

query {
  Airport(!have route in country(iso = "US")) { code }
}

query {
  Airport(has route 2 hops in country(iso = "JP")) { code }
}

query {
  Country(has airports with route within 3 hops in country(iso = "JP")) { name }
}

query {
  Airport(
    has route(code = "NRT") &&
    same route in country &&
    has inbound in same country
  ) { code }
}

query {
  Airport {
    code
    route within 2 hops -> Airport { code @hops }
  }
}

query {
  Airport(has country || code < -5) { code }
}

query {
  Airport(
    has route exactly 2 hops(code = "KIX") &&
    has route min 1 max 3 hops &&
    has inbound min 2 hops
  ) {
    code
    route max 2 hops -> Airport { code }
  }
}
