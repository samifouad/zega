// Flights — airports and routes from OpenFlights, ODbL 1.0; the three CSV files are a derived database under the same licence.
// https://openflights.org/data.php
// Generated by browser/scripts/prepare-flights.mjs: the busiest airport of the 45 busiest countries, the 15 busiest airports overall and YYC, with every non-stop route among them stored once, from the smaller airport to the larger hub.
// Source SHA-256: airports.dat 9387cdb38df5bd664da823f8ccb69fdd9b33a1888f5b7cca09c34a3cd9ff59f9, routes.dat bd373706238134f619c624c606dccc74c05c2582a977c489c81de501735f2390, countries.dat 5cbd1a7da0f4f8003f595d22d80f025f483caad7a0672354ef9bc70221d348ed
schema {
  type Country {
    name: String
    iso: String<iso2>
    airports: BASE <- Airport[]
  }

  type Airport {
    code: String
    name: String
    city: String
    at: Point from (lat, lon)
    country: BASE -> Country
    route: ROUTE -> Airport[]
    inbound: ROUTE <- Airport[]
  }

  display {
    globe(@zoom: 1.0, @tilt: 40, @center: @point(35, -40)) { Airport } : Default
    map { Airport }
    table
    graph
  }
}

unique {
  Airport { code }
  Country { iso }
}

mutation csv ["./samples/flights-countries.csv"] {
  Country(name: $name && iso: $iso) { name }
}

mutation csv ["./samples/flights-airports.csv"] {
  Airport(code: $code && name: $name && city: $city) { code at }
}

mutation csv ["./samples/flights-airports.csv"] {
  Airport(code: $code) {
    country -> link Country(iso: $country)
  }
}

mutation csv ["./samples/flights-routes.csv"] {
  Airport(code: $origin) {
    route -> link Airport(code: $destination)
  }
}
