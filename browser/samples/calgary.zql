// Calgary places — © OpenStreetMap contributors, ODbL 1.0.
// https://www.openstreetmap.org/copyright
// Generated by browser/scripts/cities-sample.mjs; coordinates are Protomaps POI label points.
// PMTiles SHA-256: f38c7346f8c1ab8940850b2295f54d5c1245730b620d55461af4b1afe157bca2
schema {
  type Place {
    name: String
    kind: String
    at: Point from (lat, lon)
  }

  display {
    map { Place } : Default
    table { Place }
    graph
  }
}

unique {
  Place { name }
}

mutation csv ["./samples/calgary.csv"] {
  Place(name: $name && kind: $kind) {
    name
    kind
    at
  }
}

// Places within 1.5 km of the Calgary Tower
query {
  Place(@distance(at, @point(51.044299581787385, -114.06313508749008)) <= 1500) order by @distance(
    at,
    @point(51.044299581787385, -114.06313508749008)
  ) {
    @id
    name
    kind
    at
    @distance(at, @point(51.044299581787385, -114.06313508749008))
  }
}
