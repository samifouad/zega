{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zega-explorer",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "dev": { "port": 8080 },
  // Ava adds explorer.zega.dev as a Custom Domain when ready to deploy.
  // The zega.dev zone ID is not a Cloudflare account ID.
  "routes": [{ "pattern": "explorer.zega.dev", "custom_domain": true }]
}
